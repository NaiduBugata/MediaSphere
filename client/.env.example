# Base URL for the MediaSphere Flask API (Mongo-backed).
#
# Local development (Vite proxies /api → http://localhost:5000 — see vite.config.js):
VITE_API_BASE_URL=/api
#
# Production static host (Vercel/Netlify/etc.): use the full Render API origin:
# VITE_API_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com/api
#
# Backend must allow this site in CORS_ORIGINS (server/.env / Render env).
