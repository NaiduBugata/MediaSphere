# MediaSphere API.
# Local: copy to .env in this folder. Railway: set the same names as service variables.
# Never commit .env. Railway injects PORT; leave API_PORT for local runs only.

# Neon PostgreSQL. The API reads and writes schema mediasphere.
NEON_DATABASE_URL=
MONGODB_COLLECTION=articles

API_HOST=0.0.0.0
API_PORT=5000
# Comma-separated browser origins. Add the Vercel URL, including a custom domain.
# https://*.vercel.app is allowed unless CORS_ALLOW_VERCEL_PREVIEWS=false.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_VERCEL_PREVIEWS=true

# Admin sign-in. ADMIN_SESSION_SECRET falls back to ADMIN_PASSWORD.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800

# News schedule runs inside this process. Keep catch-up off so a restart does not send mail or WhatsApp.
PIPELINE_ON_API=true
PIPELINE_EXECUTOR=native
PIPELINE_CATCHUP_ON_START=false
PIPELINE_INTERVAL_HOURS=1
PIPELINE_LOCK_TTL_SECONDS=2700
PIPELINE_ADMIN_TOKEN=

FETCH_INTERVAL_HOURS=
FETCH_DELAY_TOLERANCE_MINUTES=30

YOUTUBE_ENABLED=true
YOUTUBE_API_KEY=
SAKSHI_ENABLED=true
GROQ_API_KEY=

REPORT_ENABLED=true
REPORT_SCHEDULER_ON_API=true
REPORT_CATCHUP_ON_START=false
REPORT_TIMEZONE=Asia/Kolkata
REPORT_HOUR=7
REPORT_MINUTE=0

EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
REPORT_RECIPIENTS=
RESEND_API_KEY=
SMTP_USERNAME=
SMTP_PASSWORD=

WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENTS=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_ENABLED=true

# Inbound WhatsApp replies. Uses the same token, phone id, Groq key, and allowlist.
# An empty WHATSAPP_RECIPIENTS list means the bot stays silent.
CHATBOT_ENABLED=true
CHATBOT_NAME=AI Assistant
CHATBOT_LANGUAGE=English
CHATBOT_GROQ_MODEL=
